# OpenVibe.Mail — Stalwart Community, M1: receive-only on port 25.
#
# Install:
#   /opt/openvibe.stalwart/stalwart          the pinned binary (deploy/stalwart/VERSION, sha256 verified)
#   /etc/openvibe/stalwart/config.json       rendered from deploy/stalwart/config.toml
#   /etc/openvibe/stalwart.env               STALWART_DB_PASSWORD and STALWART_RECOVERY_ADMIN (root:root 0600)
#   deploy/systemd/openvibe-stalwart.slice   this service's own memory-capped slice
#
# The unit runs read-only: ProtectSystem=strict, no home, a private tmp, and only the state directory writable.
# The only capability it keeps is the one port 25 needs.
[Unit]
Description=OpenVibe.Mail Stalwart (receive-only SMTP; JMAP/IMAP on loopback)
Documentation=https://github.com/OpenVibers/OpenVibe.Mail
After=network-online.target postgresql.service
Wants=network-online.target
Slice=openvibe-stalwart.slice

[Service]
Type=simple
User=openvibe
Group=openvibe
EnvironmentFile=/etc/openvibe/stalwart.env
ExecStart=/opt/openvibe.stalwart/stalwart --config /etc/openvibe/stalwart/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# The cap is on the slice; repeated here so a unit copied out of the slice is still capped.
MemoryMax=1G
CPUQuota=100%

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
StateDirectory=openvibe-stalwart
ReadWritePaths=/var/lib/openvibe-stalwart
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
